{
  "expo": {
    "name": "Divya Pooja",
    "slug": "divya-pooja",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/divya-pooja-app-icon-white-gold-1024.png",
    "userInterfaceStyle": "light",
    "description": "English audio-guided Pooja companion",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/branding/divya-pooja-app-icon-white-gold-1024.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/branding/divya-pooja-app-icon-white-gold-48.png"
    },
    "plugins": [
      "expo-audio",
      "expo-notifications"
    ]
  }
}
